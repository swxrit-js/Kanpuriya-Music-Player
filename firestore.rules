rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.email == 'swaritshukla125@gmail.com' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();

      match /golaRecipes/{recipeId} {
        allow read: if true;
        allow write: if isOwner(userId) || isAdmin();
      }
    }

    match /playlists/{playlistId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (resource.data.createdBy == request.auth.uid || isAdmin());
    }

    match /feedback/{feedbackId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    match /songs/{songId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /background_images/{bgId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    match /email_notifications/{notifId} {
      allow read, write: if true;
    }
  }
}
